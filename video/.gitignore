# toolchain, not source
node_modules/
package-lock.json

# hyperframes working artifacts — regenerated by the build, never a source of truth
spec-intro/snapshots/
spec-intro/out/
spec-intro/.hyperframes/frame-packets/
spec-intro/vendor/
spec-intro/assets/*.ttf

# the hand-rolled first-pass renderer (superseded by hyperframes); kept out of the tree
out/
build/__pycache__/

# narration audio is generated locally with the nowvoice-tts skill (see README).
# The MP3s themselves are not committed — regenerate them from narration/*.txt.
spec-intro/audio/

# rendered MP4s are build products, not source, and binaries can't be removed from
# git history once merged. The narrated master and the six segments ship as release
# assets (that's what the README embeds); the silent master is regenerated by
# `npx hyperframes render`. Keeps ~13 MB out of the repo.
spec-intro/renders/*.mp4
spec-intro/renders/segments/*.mp4
