# toolchain, not source
node_modules/
package-lock.json

# hyperframes working artifacts — regenerated by the build, never a source of truth
spec-intro/snapshots/
spec-intro/out/
spec-intro/.hyperframes/frame-packets/
spec-intro/vendor/
spec-intro/assets/*.ttf

# the hand-rolled first-pass renderer (superseded by hyperframes); kept out of the tree
out/
build/__pycache__/

# narration audio is generated locally with the nowvoice-tts skill (see README).
# The MP3s themselves are not committed — regenerate them from narration/*.txt.
spec-intro/audio/
